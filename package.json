{
  "name": "ptit-dominion-dao",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.cjs --network sepolia",
    "dev": "vite web --host 127.0.0.1 --port 3000",
    "build": "vite build web",
    "demo": "hardhat run scripts/demo.cjs",
    "export:labs": "node scripts/export-labs.cjs",
    "first:local": "hardhat run scripts/deploy-first.cjs --network localhost",
    "first:sepolia": "hardhat run scripts/deploy-first.cjs --network sepolia",
    "basics:local": "hardhat run scripts/complete-basics.cjs --network localhost",
    "build:web3": "npm --prefix web3-app run build",
    "dev:web3": "npm --prefix web3-app start"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ethers": "6.14.0"
  },
  "devDependencies": {
    "hardhat": "2.28.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@openzeppelin/contracts": "4.9.6",
    "solc": "0.8.24",
    "dotenv": "16.5.0",
    "vite": "6.3.5"
  }
}